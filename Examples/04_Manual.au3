#cs ----------------------------------------------------------------------------
    04_Manual — PDFX demonstration: bookmarks, clickable table of contents,
    opening mode.

    The table of contents is written before the chapters: its links point to pages
    that do not exist yet. PDFX resolves those destinations at save time, when the
    object numbers of the pages are known.
#ce ----------------------------------------------------------------------------

#include "../PDFX.au3"

Global $sOut = @ScriptDir & "\04_Manual.pdf"
Global $oDocument = _PDFX_New("A4", "P", 18)

_PDFX_SetMeta($oDocument, "PDFX manual — navigation", "Numeric1", _
    "Hierarchical bookmarks, internal links and opening mode", "pdf;autoit;bookmarks")
_PDFX_SetCompression($oDocument, 6)
_PDFX_SetHeader($oDocument, "PDFX", "Navigation manual", "{date}")
_PDFX_SetFooter($oDocument, "Generated by AutoIt", "", "{page} / {pages}")
_PDFX_SetPageMode($oDocument, "UseOutlines")
_PDFX_SetPageLayout($oDocument, "SinglePage")

Global Const $COLOR_DARK = 0x1F3864
Global Const $COLOR_ACCENT = 0x2E75B6
Global Const $COLOR_TEXT = 0x333333
Global Const $COLOR_MUTED = 0x6A7690
Global Const $COLOR_RULE = 0xDDE3EF

; ================================================================== cover
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_Rect($oDocument, 0, _PDFX_Mm(36), _PDFX_PageWidth($oDocument), _PDFX_Mm(68), $PDFX_FILL)

_PDFX_SetFill($oDocument, "white")
_PDFX_SetFont($oDocument, "Helvetica", 34, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(48), "PDFX Manual")
_PDFX_SetFont($oDocument, "Helvetica", 14)
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(66), "Navigation: bookmarks, internal links and opening mode")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 11)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(124), _PDFX_PageWidth($oDocument) - _PDFX_Mm(36), _
    "A PDF does more than display pages: it also carries its own table of contents. " & _
    "Bookmarks appear in the reader's navigation pane, and internal links move from " & _
    "a contents list to a chapter without leaving the document. This manual is produced " & _
    "by the engine it describes: every heading below also exists as a bookmark, and every " & _
    "contents line is a clickable area.")

_PDFX_SetFill($oDocument, $COLOR_MUTED)
_PDFX_SetFont($oDocument, "Helvetica", 9)
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(168), "Author: Numeric1 — https://www.autoitscript.com/forum/")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(174), "No dependencies: no COM, no third-party DLL, no temporary file.")

_PDFX_AddBookmark($oDocument, "Cover", 0, 1)

; ================================================================== contents
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 24, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(36), "Contents")

_PDFX_SetStroke($oDocument, $COLOR_RULE)
_PDFX_SetLineWidth($oDocument, 0.5)

Global $aToc[5][3] = [ _
    ["Getting started", 3, "Create a document, choose a format, add text"], _
    ["First document", 4, "Header, footer and first save"], _
    ["Bookmarks", 5, "Hierarchy, levels and destinations"], _
    ["Internal links", 6, "Clickable contents and forward links"], _
    ["Colophon", 7, "Engine version and references"]]

Global $fTocX = _PDFX_Mm(18)
Global $fTocWidth = _PDFX_PageWidth($oDocument) - _PDFX_Mm(36)
Global $fTocY = _PDFX_Mm(60)

For $iIndex = 0 To UBound($aToc) - 1
    _PDFX_SetFill($oDocument, $COLOR_DARK)
    _PDFX_SetFont($oDocument, "Helvetica", 12, "B")
    _PDFX_Text($oDocument, $fTocX, $fTocY, $aToc[$iIndex][0])
    _PDFX_SetFill($oDocument, $COLOR_ACCENT)
    _PDFX_SetFont($oDocument, "Helvetica", 12)
    _PDFX_TextAlign($oDocument, $fTocX, $fTocY, $fTocWidth, String($aToc[$iIndex][1]), "R")
    _PDFX_SetFill($oDocument, $COLOR_MUTED)
    _PDFX_SetFont($oDocument, "Helvetica", 9)
    _PDFX_Text($oDocument, $fTocX, $fTocY + 14, $aToc[$iIndex][2])

    ; Leader line and clickable area across the full width.
    _PDFX_Line($oDocument, $fTocX, $fTocY + 26, $fTocX + $fTocWidth, $fTocY + 26)
    _PDFX_LinkPage($oDocument, $fTocX, $fTocY - 2, $fTocWidth, 28, $aToc[$iIndex][1], _PDFX_Mm(44))

    $fTocY += _PDFX_Mm(28)
Next

_PDFX_AddBookmark($oDocument, "Contents", 0, 2, _PDFX_Mm(36))

; ================================================================== getting started
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_ACCENT)
_PDFX_SetFont($oDocument, "Helvetica", 9, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(36), "CHAPTER 1")
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 20, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(44), "Getting started")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(62), $fTocWidth, _
    "Three calls are enough to obtain a valid PDF: _PDFX_New creates the document, " & _
    "the drawing functions fill the pages, and _PDFX_Save writes the file. " & _
    "The handle returned by _PDFX_New holds the whole state: fonts, colours, margins, " & _
    "bookmarks and links. No global variable is required in the calling script.")

_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 14, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(132), "Installation")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(142), $fTocWidth, _
    "1. Copy PDFX.au3 next to your script." & @CRLF & _
    "2. Add #include ""PDFX.au3"" at the top." & @CRLF & _
    "3. Call _PDFX_New, draw, then _PDFX_Save." & @CRLF & _
    "4. Check the file with Tools/pdfcheck.py if needed.")

_PDFX_SetFill($oDocument, $COLOR_MUTED)
_PDFX_SetFont($oDocument, "Helvetica", 9)
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(222), _
    "Nothing needs to be registered: the engine writes the PDF directly.")

_PDFX_AddBookmark($oDocument, "Getting started", 0, 3, _PDFX_Mm(44))
_PDFX_AddBookmark($oDocument, "Installation", 1, 3, _PDFX_Mm(132))

; ================================================================== first document
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_ACCENT)
_PDFX_SetFont($oDocument, "Helvetica", 9, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(36), "CHAPTER 2")
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 20, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(44), "First document")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(62), $fTocWidth, _
    "A minimal document fits in a few lines. The header and footer are set once, " & _
    "then repeated on every page with the {page}, {pages} and {date} tokens. " & _
    "The footer of this manual already uses them.")

_PDFX_SetFill($oDocument, 0xF4F7FB)
_PDFX_Rect($oDocument, _PDFX_Mm(18), _PDFX_Mm(94), $fTocWidth, _PDFX_Mm(44), $PDFX_FILL)
_PDFX_SetFill($oDocument, 0x0B3D2E)
_PDFX_SetFont($oDocument, "Courier", 9)
_PDFX_Text($oDocument, _PDFX_Mm(22), _PDFX_Mm(100), '#include "PDFX.au3"')
_PDFX_Text($oDocument, _PDFX_Mm(22), _PDFX_Mm(107), 'Local $d = _PDFX_New("A4", "P", 18)')
_PDFX_Text($oDocument, _PDFX_Mm(22), _PDFX_Mm(114), '_PDFX_SetFont($d, "Helvetica", 12)')
_PDFX_Text($oDocument, _PDFX_Mm(22), _PDFX_Mm(121), '_PDFX_Text($d, 40, 60, "Hello")')
_PDFX_Text($oDocument, _PDFX_Mm(22), _PDFX_Mm(128), '_PDFX_Save($d, "hello.pdf")')

_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 14, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(162), "Header and footer")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(172), $fTocWidth, _
    "The header sits in the top margin, the footer in the bottom margin; the body text " & _
    "starts below both. _PDFX_SetHeader and _PDFX_SetFooter each take three zones: " & _
    "left, centre and right. An empty string hides the corresponding zone, which makes " & _
    "it easy to compose a quiet pagination.")

_PDFX_AddBookmark($oDocument, "First document", 0, 4, _PDFX_Mm(44))
_PDFX_AddBookmark($oDocument, "Header and footer", 1, 4, _PDFX_Mm(162))

; ================================================================== bookmarks
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_ACCENT)
_PDFX_SetFont($oDocument, "Helvetica", 9, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(36), "CHAPTER 3")
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 20, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(44), "Reference")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(62), $fTocWidth, _
    "This chapter covers the two navigation mechanisms: bookmarks, which structure " & _
    "the document in the reader's pane, and destinations, which define the exact point " & _
    "where each bookmark or link opens.")

_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 14, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(102), "Bookmarks")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(112), $fTocWidth, _
    "A bookmark is a title, a level and a destination. _PDFX_AddBookmark returns its " & _
    "ordinal number, which makes a table of contents easy to verify. Level 0 is the " & _
    "root; a bookmark can descend at most one level below the previous one. " & _
    "A deeper request is clamped to that maximum, without any error: " & _
    "an outline always stays valid.")

_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 14, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(162), "Destinations")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(172), $fTocWidth, _
    "Without a vertical position, the destination is /Fit: the whole page is shown. " & _
    "With one, it becomes /XYZ and the reader places that point at the top of the " & _
    "window. That is what makes a bookmark open on a precise paragraph rather than " & _
    "on the beginning of a chapter.")

_PDFX_AddBookmark($oDocument, "Reference", 0, 5, _PDFX_Mm(44))
_PDFX_AddBookmark($oDocument, "Bookmarks", 1, 5, _PDFX_Mm(102))
_PDFX_AddBookmark($oDocument, "Destinations", 2, 5, _PDFX_Mm(162))

; ================================================================== internal links
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_ACCENT)
_PDFX_SetFont($oDocument, "Helvetica", 9, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(36), "REFERENCE (CONTINUED)")
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 20, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(44), "Internal links")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(62), $fTocWidth, _
    "_PDFX_LinkPage turns a rectangle into a clickable area. The target page may " & _
    "not exist yet: this is the case of the table of contents, written before the " & _
    "chapters. The engine keeps the request pending and writes it at save time, when " & _
    "every page finally has its object number. A link to a page that was never " & _
    "created is ignored without error.")

_PDFX_SetFill($oDocument, 0xEAF1FB)
_PDFX_Rect($oDocument, _PDFX_Mm(18), _PDFX_Mm(117), $fTocWidth, _PDFX_Mm(18), $PDFX_FILL)
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 12, "B")
_PDFX_Text($oDocument, _PDFX_Mm(24), _PDFX_Mm(123), "Back to contents")
_PDFX_LinkPage($oDocument, _PDFX_Mm(18), _PDFX_Mm(117), $fTocWidth, _PDFX_Mm(18), 2, _PDFX_Mm(36))

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(152), $fTocWidth, _
    "The rectangle above targets page 2, which already exists: it is a backward link. " & _
    "The contents entries pointed to future pages: two cases handled by the same call.")

_PDFX_AddBookmark($oDocument, "Internal links", 1, 6, _PDFX_Mm(44))

; ================================================================== colophon
_PDFX_AddPage($oDocument)
_PDFX_SetFill($oDocument, $COLOR_DARK)
_PDFX_SetFont($oDocument, "Helvetica", 20, "B")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(44), "Colophon")

_PDFX_SetFill($oDocument, $COLOR_TEXT)
_PDFX_SetFont($oDocument, "Helvetica", 10)
_PDFX_TextWrap($oDocument, _PDFX_Mm(18), _PDFX_Mm(64), $fTocWidth, _
    "Document produced by PDFX " & $PDFX_VERSION & " for AutoIt, with no external " & _
    "library and no COM component. Content streams are compressed with FlateDecode " & _
    "by a compressor written in AutoIt. The document identifier is a deterministic " & _
    "fingerprint: two runs over the same content produce the same file, timestamps " & _
    "aside.")

_PDFX_SetFill($oDocument, $COLOR_MUTED)
_PDFX_SetFont($oDocument, "Helvetica", 9)
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(112), "Author: Numeric1")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(118), "Forum: https://www.autoitscript.com/forum/")
_PDFX_Text($oDocument, _PDFX_Mm(18), _PDFX_Mm(124), "Reference: ISO 32000-1, section 12.3 (interactive features, outlines and annotations)")

_PDFX_AddBookmark($oDocument, "Colophon", 0, 7, _PDFX_Mm(44))

; ================================================================== write
FileDelete($sOut)
If Not _PDFX_Save($oDocument, $sOut) Then
    ConsoleWrite("Save failed: " & @error & @CRLF)
    Exit 1
EndIf
_PDFX_Close($oDocument)

ConsoleWrite("OK " & $sOut & " (" & FileGetSize($sOut) & " bytes, " & _
    _PDFX_PageCount($oDocument) & " pages)" & @CRLF)
